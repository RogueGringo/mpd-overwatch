{
  "name": "MPD Overwatch",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -e '.[deploy]'",
  "forwardPorts": [8050],
  "portsAttributes": {
    "8050": {
      "label": "MPD Overwatch Dashboard",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postStartCommand": "mpd-overwatch serve --host 0.0.0.0 --no-debug",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
